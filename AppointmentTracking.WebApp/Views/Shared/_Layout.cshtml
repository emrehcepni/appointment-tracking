<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DireksiyonTakip</title>

    <link href="~/css/site.css" rel="stylesheet" />
    <!-- AdminLTE CSS -->
    <link rel="stylesheet" href="~/AdminLTE-4.0.0-beta3/css/adminlte.min.css" />
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <!-- Google Font: Source Sans Pro -->
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet" />
</head>
<body class="hold-transition sidebar-mini">
<nav id="sidebar" class="col-md-3 col-lg-2 d-md-block bg-light sidebar show">
    <div class="position-sticky">
        <div class="text-center mb-3">
            <h3>Direksiyon Takip</h3>
        </div>
        <ul class="nav flex-column">
            <li class="nav-item">
                <a class="nav-link @(ViewBag.ActiveMenuItem == "Randevu" ? "active" : "")" href="/Appointment">
                    <i class="bi bi-calendar-event"></i> Randevu
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewBag.ActiveMenuItem == "Adaylar" ? "active" : "")" href="/Candidate">
                    <i class="bi bi-person"></i> Adaylar
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewBag.ActiveMenuItem == "Araçlar" ? "active" : "")" href="/Vehicle">
                    <i class="bi bi-car-front"></i> Araçlar
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewBag.ActiveMenuItem == "Eğitmenler" ? "active" : "")" href="/Instructor">
                    <i class="bi bi-person-video2"></i> Eğitmenler
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="/Account/Logout">
                    <i class="bi bi-box-arrow-right"></i> Çıkış
                </a>
            </li>
        </ul>
    </div>
</nav>
<div class="wrapper">
    @RenderBody()
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/menu.css" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.querySelector('main'); // İçerik alanı

        if (sidebarToggle && sidebar && mainContent) {
            sidebarToggle.addEventListener('click', function () {
                sidebar.classList.toggle('show');

                // Menü kapalıysa içerik tam ekran olsun, açıksa eski haline dönsün
                if (sidebar.classList.contains('show')) {
                    mainContent.style.marginLeft = '250px';
                    mainContent.style.width = 'calc(100% - 250px)';
                } else {
                    mainContent.style.marginLeft = '0';
                    mainContent.style.width = '100%';
                }
            });
        } else {
            console.error('sidebarToggle, sidebar veya main elementi bulunamadı.');
        }
    });
</script>

<!-- jQuery -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
<!-- Bootstrap 4 -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/twitter-bootstrap/4.6.0/js/bootstrap.bundle.min.js"></script>
<!-- AdminLTE JS -->
<script src="~/AdminLTE-4.0.0-beta3/js/adminlte.min.js"></script>
@RenderSection("Scripts", required: false)

</body>
</html>