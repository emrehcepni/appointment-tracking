@model List<AppointmentTracking.Domain.Entities.Candidate>

@*Menü Bar*@
<div class="container-fluid">
    <div class="row">
        <nav id="sidebar" class="col-md-3 col-lg-2 d-md-block bg-light sidebar show">
            <div class="position-sticky">
                <div class="text-center mb-3">
                    <h3>Direksiyon Takip</h3>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewBag.ActiveMenuItem == "Randevu" ? "active" : "")" href="/Appointment">
                            <i class="bi bi-calendar-event"></i> Randevu
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewBag.ActiveMenuItem == "Adaylar" ? "active" : "")" href="/Candidate">
                            <i class="bi bi-person"></i> Adaylar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewBag.ActiveMenuItem == "Araçlar" ? "active" : "")" href="/Vehicle">
                            <i class="bi bi-car-front"></i> Araçlar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewBag.ActiveMenuItem == "Eğitmenler" ? "active" : "")" href="/Instructor">
                            <i class="bi bi-person-video2"></i> Eğitmenler
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Account/Logout">
                            <i class="bi bi-box-arrow-right"></i> Çıkış
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <h2>Aday Listesi</h2>
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">

                <div class="btn-toolbar mb-2 mb-md-0">
                    <button id="sidebarToggle" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-list"></i> Menüyü Kapat/Aç
                    </button>
                </div>
            </div>
            <form asp-action="Add" method="post" class="mb-3">
                <div class="form-group">
                    <label for="FirstName">Ad</label>
                    <input type="text" class="form-control" id="FirstName" name="FirstName" required>
                </div>
                <div class="form-group">
                    <label for="LastName">Soyad</label>
                    <input type="text" class="form-control" id="LastName" name="LastName" required>
                </div>
                <div class="form-group">
                    <label for="PhoneNumber">Telefon</label>
                    <input type="text" class="form-control" id="PhoneNumber" name="PhoneNumber" required>
                </div>
                <div class="form-group">
                    <label for="LessonsHour">Ders Saati</label>
                    <input type="text" class="form-control" id="LessonsHour" name="LessonsHour" required>
                </div>
                <button type="submit" class="btn btn-primary">Aday Ekle</button>
            </form>

            <form asp-action="Index" method="get" class="form-inline mb-3">
                <div class="form-group">
                    <input type="text" name="searchString" class="form-control" placeholder="Ara..." value="@ViewBag.SearchString" />
                </div>
                <button type="submit" class="btn btn-primary ml-2">Ara</button>
                <a asp-action="Index" class="btn btn-secondary ml-2">Temizle</a>
            </form>

            <table class="table">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>Telefon</th>
                        <th>Ders Saati</th>
                        <th>İşlem</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var candidate in Model)
                    {
                        <tr>
                            <td>@candidate.FirstName</td>
                            <td>@candidate.LastName</td>
                            <td>@candidate.PhoneNumber</td>
                            <td>@candidate.LessonsHour</td>
                            <td>
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Bu adayı silmek istediğinizden emin misiniz?');">
                                    <input type="hidden" name="selectedCandidateId" value="@candidate.CandidateId" />
                                    <button type="submit" class="btn btn-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div>
                @if (ViewBag.TotalPages > 1)
                {
                    for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <a href="@Url.Action("Index", new { page = i, searchString = ViewBag.SearchString })"
                           class="btn btn-default @(i == ViewBag.CurrentPage ? "active" : "")">@i</a>
                    }
                }
            </div>

        </main>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/menu.css" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.querySelector('main'); // İçerik alanı

        if (sidebarToggle && sidebar && mainContent) {
            sidebarToggle.addEventListener('click', function () {
                sidebar.classList.toggle('show');

                // Menü kapalıysa içerik tam ekran olsun, açıksa eski haline dönsün
                if (sidebar.classList.contains('show')) {
                    mainContent.style.marginLeft = '250px';
                    mainContent.style.width = 'calc(100% - 250px)';
                } else {
                    mainContent.style.marginLeft = '0';
                    mainContent.style.width = '100%';
                }
            });
        } else {
            console.error('sidebarToggle, sidebar veya main elementi bulunamadı.');
        }
    });
</script>