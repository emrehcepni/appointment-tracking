@model List<AppointmentTracking.Domain.Entities.Instructor>
@*Menü Bar*@
<div class="container-fluid">
    <div class="row">
        <nav id="sidebar" class="col-md-3 col-lg-2 d-md-block bg-light sidebar show">
            <div class="position-sticky pt-3">
                <div class="text-center mb-3">
                    <h3>Direksiyon Takip</h3>
                </div>
                <ul class="nav flex-column">
                    <li class="nav-item">
                        <a class="nav-link @(ViewBag.ActiveMenuItem == "Randevu" ? "active" : "")" href="/Appointment/Index">
                            <i class="bi bi-calendar-event"></i> Randevu
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewBag.ActiveMenuItem == "Adaylar" ? "active" : "")" href="/Candidate/Index">
                            <i class="bi bi-person"></i> Adaylar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewBag.ActiveMenuItem == "Araçlar" ? "active" : "")" href="/Vehicle/Index">
                            <i class="bi bi-car-front"></i> Araçlar
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewBag.ActiveMenuItem == "Eğitmenler" ? "active" : "")" href="/Instructor/Index">
                            <i class="bi bi-person-video2"></i> Eğitmenler
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Account/Logout">
                            <i class="bi bi-box-arrow-right"></i> Çıkış
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <h2>Eğitmen Listesi</h2>
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">

                <div class="btn-toolbar mb-2 mb-md-0">
                    <button id="sidebarToggle" class="btn btn-sm btn-outline-secondary">
                        <i class="bi bi-list"></i> Menüyü Kapat/Aç
                    </button>
                </div>
            </div>

            <form asp-action="Index" method="get" class="mb-3 d-flex">
                <input type="text" class="form-control me-2" name="searchString" placeholder="Eğitmen Ara..." value="@ViewBag.SearchString">
                <button type="submit" class="btn btn-primary">Ara</button>
            </form>

            <form asp-action="AddOrUpdate" method="post" class="mb-3">
                <input type="hidden" id="InstructorId" name="InstructorId" value="0" />

                <div class="row">
                    <div class="col-md-3">
                        <label for="FirstName">Ad</label>
                        <input type="text" class="form-control" id="FirstName" name="FirstName" required>
                    </div>
                    <div class="col-md-3">
                        <label for="LastName">Soyad</label>
                        <input type="text" class="form-control" id="LastName" name="LastName" required>
                    </div>
                    <div class="col-md-3">
                        <label for="PhoneNumber">Telefon</label>
                        <input type="text" class="form-control" id="PhoneNumber" name="PhoneNumber" required>
                    </div>
                    <div class="col-md-3">
                        <label for="LicanceType">Lisans Türü</label>
                        <select id="LicanceType" name="LicanceType" class="form-control" multiple>
                            <option value="B">B</option>
                            <option value="A">A</option>
                            <option value="D">D</option>
                            <option value="C">C</option>
                            <option value="CE">CE</option>
                        </select>
                    </div>

                </div>
                <button type="submit" class="btn btn-success mt-3">Kaydet</button>
            </form>

            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Ad</th>
                        <th>Soyad</th>
                        <th>Telefon</th>
                        <th>Lisans Türü</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var instructor in Model)
                    {
                        <tr>
                            <td>@instructor.FirstName</td>
                            <td>@instructor.LastName</td>
                            <td>@instructor.PhoneNumber</td>
                            <td>@instructor.LicanceType</td>
                            <td>
                                <button onclick="editInstructor(@instructor.InstructorId, '@instructor.FirstName', '@instructor.LastName', '@instructor.PhoneNumber', '@instructor.LicanceType')" class="btn btn-warning">Düzenle</button>

                                <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Bu eğitmeni silmek istediğinizden emin misiniz?');">
                                    <input type="hidden" name="instructorId" value="@instructor.InstructorId" />
                                    <button type="submit" class="btn btn-danger">Sil</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <script>
                function editInstructor(id, firstName, lastName, phoneNumber, licanceType) {
                    document.getElementById("InstructorId").value = id;
                    document.getElementById("FirstName").value = firstName;
                    document.getElementById("LastName").value = lastName;
                    document.getElementById("PhoneNumber").value = phoneNumber;

                    // Lisans türlerini virgüle göre ayır ve seçili hale getir
                    let selectedLicances = licanceType.split(",");
                    let selectElement = document.getElementById("LicanceType");

                    for (let i = 0; i < selectElement.options.length; i++) {
                        selectElement.options[i].selected = selectedLicances.includes(selectElement.options[i].value);
                    }
                }
            </script>

        </main>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/menu.css" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
            document.addEventListener('DOMContentLoaded', function () {
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.querySelector('main'); // İçerik alanı

        if (sidebarToggle && sidebar && mainContent) {
            sidebarToggle.addEventListener('click', function () {
                sidebar.classList.toggle('show');

                // Menü kapalıysa içerik tam ekran olsun, açıksa eski haline dönsün
                if (sidebar.classList.contains('show')) {
                    mainContent.style.marginLeft = '250px';
                    mainContent.style.width = 'calc(100% - 250px)';
                } else {
                    mainContent.style.marginLeft = '0';
                    mainContent.style.width = '100%';
                }
            });
        } else {
            console.error('sidebarToggle, sidebar veya main elementi bulunamadı.');
        }
    });

</script>