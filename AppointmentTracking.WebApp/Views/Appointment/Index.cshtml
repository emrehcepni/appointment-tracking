@model List<AppointmentTracking.Domain.Entities.Appointment>

<div class="container-fluid">
    <div class="row">
        <main class="col-md-9 ms-sm-auto col-lg-10 px-md-4">
            <h2>Randevu Takvimi</h2>

            <!-- Filtreleme Formu -->
            <div class="row">
                <div class="col-md-3">
                    <label>Ay Seç</label>
                    <select id="month" class="form-control">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label>Hafta Seç</label>
                    <select id="week" class="form-control">
                        @for (int i = 1; i <= 5; i++)
                        {
                            <option value="@i">@i. Hafta</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label>Hoca</label>
                    <select id="instructorId" class="form-control">
                        @foreach (var instructor in ViewBag.Instructors)
                        {
                            <option value="@instructor.InstructorId">@instructor.FirstName @instructor.LastName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button id="filterBtn" class="btn btn-primary mt-4">Filtrele</button>
                </div>
            </div>

            <!-- Takvim Tablosu -->
            <div class="table-responsive mt-4">
                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Saat</th>
                            <th>Pzt</th>
                            <th>Sal</th>
                            <th>Çar</th>
                            <th>Per</th>
                            <th>Cum</th>
                            <th>Cmt</th>
                            <th>Paz</th>
                        </tr>
                    </thead>
                    <tbody id="appointmentTable"></tbody>
                </table>
            </div>

            <!-- Randevu Modal -->
            <div class="modal fade" id="appointmentModal">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Randevu Ekle/Düzenle</h5>
                            <button type="button" class="close" data-dismiss="modal">&times;</button>
                        </div>
                        <div class="modal-body">
                            <input type="hidden" id="selectedDate" />
                            <input type="hidden" id="selectedTime" />

                            <label>Aday Seç:</label>
                            <select id="candidateId" class="form-control">
                                @foreach (var c in ViewBag.Candidates)
                                {
                                    <option value="@c.CandidateId">@c.FirstName @c.LastName</option>
                                }
                            </select>

                            <label>Araç Seç:</label>
                            <select id="vehicleId" class="form-control"></select>
                        </div>
                        <div class="modal-footer">
                            <button id="saveAppointmentBtn" class="btn btn-success">Kaydet</button>
                            <button class="btn btn-secondary" data-dismiss="modal">Kapat</button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- JavaScript Kodları -->
            <script>
                $(document).ready(function () {
                    $("#filterBtn").click(function () {
                        $.get("/Appointment/GetAppointments", {
                            month: $("#month").val(),
                            week: $("#week").val(),
                            instructorId: $("#instructorId").val()
                        }, generateTable);
                    });

                    function generateTable(appointments) {
                        const tbody = $("#appointmentTable").empty();
                        const hours = [...Array(10).keys()].map(h => h + 9);
                        const startOfWeek = new Date();
                        startOfWeek.setDate(startOfWeek.getDate() - startOfWeek.getDay() + 1);

                        hours.forEach(hour => {
                            let row = `<tr><td>${hour}:00</td>`;
                            for (let i = 0; i < 7; i++) {
                                const day = new Date(startOfWeek);
                                day.setDate(day.getDate() + i);
                                const dateStr = day.toISOString().split("T")[0];

                                const appointment = appointments.find(a => {
                                    const aDate = new Date(a.startTime);
                                    return aDate.getDay() === day.getDay() && aDate.getHours() === hour;
                                });

                                if (appointment) {
                                    row += `<td class="appointment-cell bg-warning text-white" data-date="${dateStr}" data-time="${hour}:00">
                                                <b>${appointment.candidate}</b><br>${appointment.vehicle}
                                            </td>`;
                                } else {
                                    row += `<td class="appointment-cell" data-date="${dateStr}" data-time="${hour}:00">
                                                <span class="text-muted">Boş</span>
                                            </td>`;
                                }
                            }
                            row += "</tr>";
                            tbody.append(row);
                        });
                    }

                    $(document).on("click", ".appointment-cell", function () {
                        const date = $(this).data("date");
                        const time = $(this).data("time");

                        const start = new Date(`${date}T${time}`);
                        const end = new Date(start);
                        end.setHours(end.getHours() + 1);

                        $("#selectedDate").val(date);
                        $("#selectedTime").val(time);

                        $.get("/Appointment/GetAvailableVehicles", {
                            startTime: start.toISOString(),
                            endTime: end.toISOString()
                        }, function (vehicles) {
                            const dropdown = $("#vehicleId").empty();
                            dropdown.append('<option value="">Araç Seçiniz</option>');
                            vehicles.forEach(v => dropdown.append(`<option value="${v.vehicleId}">${v.licensePlate}</option>`));
                        });

                        $("#appointmentModal").modal("show");
                    });

                    $("#saveAppointmentBtn").click(function () {
                        const start = new Date($("#selectedDate").val() + "T" + $("#selectedTime").val());
                        const data = {
                            instructorId: $("#instructorId").val(),
                            candidateId: $("#candidateId").val(),
                            vehicleId: $("#vehicleId").val(),
                            startTime: start.toISOString()
                        };

                        if (!data.candidateId || !data.vehicleId || !data.startTime) return alert("Tüm alanlar zorunludur.");

                        $.post("/Appointment/SaveAppointment", data, function (res) {
                            if (res.success) {
                                $("#appointmentModal").modal("hide");
                                alert("Randevu kaydedildi!");
                                $("#filterBtn").click();
                            } else {
                                alert(res.message || "Kayıt hatası.");
                            }
                        });
                    });
                });
            </script>
        </main>
    </div>
</div>
