                success: function (response) {
                    if (response.success) {
                        $("#appointmentModal").modal("hide");
                        alert("Randevu başarıyla kaydedildi!");
                        $("#filterBtn").click();
                    } else {
                        alert(response.message || "Randevu kaydedilirken hata oluştu.");
                    }
                },
                error: function () {
                    alert("Randevu kaydedilirken hata oluştu.");
                }
            });
        });
      
    
    </script>
</div>

        </main>
    </div>
</div>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
<link rel="stylesheet" href="~/css/menu.css" />
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const sidebarToggle = document.getElementById('sidebarToggle');
        const sidebar = document.getElementById('sidebar');
        const mainContent = document.querySelector('main'); // İçerik alanı

        if (sidebarToggle && sidebar && mainContent) {
            sidebarToggle.addEventListener('click', function () {
                sidebar.classList.toggle('show');

                // Menü kapalıysa içerik tam ekran olsun, açıksa eski haline dönsün
                if (sidebar.classList.contains('show')) {
                    mainContent.style.marginLeft = '250px';
                    mainContent.style.width = 'calc(100% - 250px)';
                } else {
                    mainContent.style.marginLeft = '0';
                    mainContent.style.width = '100%';
                }
            });
        } else {
            console.error('sidebarToggle, sidebar veya main elementi bulunamadı.');
        }
    });
</script>